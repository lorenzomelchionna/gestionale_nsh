# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (Docker Compose): porta 5433 mappata dall'host
DATABASE_URL=postgresql+asyncpg://nsh:nshpass@localhost:5433/new_style_hair
# Railway: usa l'URL interno fornito dal plugin PostgreSQL
# DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<host>:<port>/<db>

POSTGRES_USER=nsh
POSTGRES_PASSWORD=nshpass
POSTGRES_DB=new_style_hair

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev
REDIS_URL=redis://localhost:6379/0
# Railway: usa l'URL interno fornito dal plugin Redis
# REDIS_URL=redis://default:<pass>@<host>:<port>

# ── JWT ───────────────────────────────────────────────────────────────────────
# OBBLIGATORIO in produzione: stringa random >= 32 caratteri
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@newstylair.it
EMAILS_FROM_NAME=New Style Hair

# ── App ───────────────────────────────────────────────────────────────────────
# `development` stampa log leggibili a occhio; qualunque altro valore li scrive
# in JSON (una riga = un oggetto) perché si possano filtrare.
APP_ENV=development
# URL pubblico del frontend (Railway: es. https://nsh-frontend.up.railway.app)
FRONTEND_URL=http://localhost:5173

# ── Log ───────────────────────────────────────────────────────────────────────
# INFO scrive una riga per richiesta servita: è quella traccia che permette di
# dire, dopo un accesso non autorizzato, quali schede sono state aperte.
# WARNING tiene solo errori ed eventi di sicurezza (login falliti, permessi
# negati) e fa sparire il registro degli accessi.
LOG_LEVEL=INFO

# ── Frontend (build-time) ─────────────────────────────────────────────────────
# URL pubblico del backend — usato da Vite al build time
# Railway: https://<backend-service>.up.railway.app
VITE_API_URL=

# ── Sentry (opzionale) ────────────────────────────────────────────────────────
# Lascia vuoto per disabilitare il monitoraggio errori
SENTRY_DSN=

# ── Twilio WhatsApp (opzionale) ───────────────────────────────────────────────
# Lascia vuoto per stub mode (messaggi loggati in console, niente invii reali)
# Sandbox Twilio: TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Template approvati da Meta (SID che comincia con HX...), uno per messaggio.
#
# Servono per i messaggi che parte il salone: fuori dalla finestra di 24 ore
# da un messaggio della cliente, WhatsApp rifiuta il testo libero (errore
# 63016). In Sandbox si possono lasciare vuoti — lì il `join` apre una
# sessione e il testo libero passa — ma in produzione senza questi i messaggi
# automatici non partono.
#
# Le risposte dalla pagina Chat non ne hanno bisogno: stanno dentro la
# finestra per costruzione, visto che esistono perché la cliente ha scritto.
TWILIO_TEMPLATE_CONFERMA=
TWILIO_TEMPLATE_PROMEMORIA=
TWILIO_TEMPLATE_COMPLEANNO=
TWILIO_TEMPLATE_RESET_PASSWORD=
