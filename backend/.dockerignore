# Keep the production image free of anything only needed for development.
# Railway builds from this context, so excluded paths never reach the deploy.
tests/
pytest.ini
requirements-dev.txt
scripts/

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

.env
.env.*
*.log

# Stato del beat di Celery creato in locale (sul Mac è un dbm che Linux non
# legge): copiato nell'immagine, il worker lo trova «corrupted» all'avvio.
celerybeat-schedule*
celerybeat.pid
